[Unit]
Description=Telegram MCP Relay (shared loopback endpoint)

[Service]
Type=exec
ExecStart=%h/.local/bin/telegram-mcp-relay %h/.config/telegram-mcp-relay/config.toml
EnvironmentFile=%h/.config/telegram-mcp-relay/relay.env
WorkingDirectory=%h
UMask=0077
Restart=on-failure
RestartSec=5s
# Allow uploads/downloads up to 600 seconds plus bookkeeping/I/O drainage; review host margin.
TimeoutStopSec=660s
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/telegram-mcp-relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
